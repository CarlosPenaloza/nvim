" Canal: HolaMundo - udemy
set number
set relativenumber
set mouse=nv
set numberwidth=1
syntax enable
set showcmd
set ruler
set encoding=utf-8
set showmatch
set smarttab
set expandtab
set softtabstop=2
set shiftwidth=2
set laststatus=2
set clipboard=unnamedplus

